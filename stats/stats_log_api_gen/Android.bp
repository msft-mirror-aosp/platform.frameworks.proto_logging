// ==========================================================
// Build the host executable: stats-log-api-gen
// ==========================================================
package {
    default_team: "trendy_team_android_telemetry_client_infra",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_defaults {
    name: "stats-log-api-gen-defaults",
    srcs: [
        "Collation.cpp",
        "settings_provider.cpp",
        "utils.cpp",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-deprecated-declarations",
        "-DJAVA_INCLUDE_SRCS_DIR=\"java/\"",
        "-DCC_INCLUDE_HDRS_DIR=\"cc_hdrs/\"",
        "-DCC_INCLUDE_SRCS_DIR=\"cc_srcs/\"",
    ],
    static_libs: [
        "libprotobuf-cpp-full",
    ],
    whole_static_libs: [
        "libstats_proto_host",
    ],
    proto: {
        type: "full",
    },
    device_supported: false,
    host_supported: true,
}

cc_binary_host {
    name: "stats-log-api-gen",
    defaults: ["stats-log-api-gen-defaults"],
    srcs: [
        "java_writer.cpp",
        "java_writer_q.cpp",
        "java_writer_vendor.cpp",
        "main.cpp",
        "native_writer.cpp",
        "native_writer_vendor.cpp",
        "rust_writer.cpp",
    ],
    cflags: [
        "-DWITH_VENDOR",
    ],

    static_libs: [
        "libbase",
    ],

    required: [
        "stats-log-api-gen-copy-java-srcs",
        "stats-log-api-gen-copy-cc-hdrs",
        "stats-log-api-gen-copy-cc-srcs",
    ],

    stl: "libc++_static",

    tidy: true,

    tidy_checks: [
        "android-*",
        "bugprone-*",
        "cert-*",
        "clang-analyzer-security*",
        "google-*",
        "misc-*",
        "performance-*",
        "-bugprone-narrowing-conversions", // lots of unsigned -> int conversions
        "-cert-err34-c",
        "-cert-msc30-c", // warning: rand() has limited randomness; use C++11 random library
        "-cert-msc50-cpp", // warning: rand() has limited randomness; use C++11 random library
    ],

    tidy_checks_as_errors: [
        "android-*",
        "bugprone-*",
        "cert-*",
        "clang-analyzer-security*",
        "google-*",
        "misc-*",
        "performance-*",
    ],
}

prebuilt_etc_host {
    name: "stats-log-api-gen-copy-java-srcs",
    srcs: [":stats-log-api-gen-java-srcs"],
    sub_dir: "stats-log-api-gen/java",
}

prebuilt_etc_host {
    name: "stats-log-api-gen-copy-cc-hdrs",
    srcs: ["include_cc_hdrs/*.h"],
    sub_dir: "stats-log-api-gen/cc_hdrs",
}

prebuilt_etc_host {
    name: "stats-log-api-gen-copy-cc-srcs",
    srcs: ["include_cc_srcs/*.cpp"],
    sub_dir: "stats-log-api-gen/cc_srcs",
}

filegroup {
    name: "stats-log-api-gen-java-srcs",
    srcs: ["include_java/*.java"],
    path: "include_java",
}

cc_library_static {
    name: "stats-log-api-gen-cc-lib",
    srcs: ["include_cc_srcs/StatsHistogram.cpp"],
    export_include_dirs: ["include_cc_hdrs"],
    host_supported: true,
    vendor_available: true,
    min_sdk_version: "30",
    apex_available: [
        "//apex_available:anyapex",
        "//apex_available:platform",
    ],
}

// ==========================================================
// Build the host test executable: stats-log-api-gen-test
// ==========================================================
cc_test_host {
    name: "stats-log-api-gen-test",
    defaults: ["stats-log-api-gen-defaults"],
    test_suites: [
        "general-tests",
    ],
    cflags: [
        "-Wextra",
        "-g",
        "-DUNIT_TEST",
    ],
    srcs: [
        "test_api_gen_external_atom.cpp",
        "test_api_gen.cpp",
        "test_collation.cpp",
        "test_feature_atoms.proto",
        "test_vendor_atoms.proto",
        "test_vendor_extension_atoms.proto",
        "test.proto",
    ],

    static_libs: [
        "libgmock_host",
        "libstatslog_test_external",
        "libstatspull-fake",
        "libstatssocket-fake",
    ],

    shared_libs: [
        "android.frameworks.stats-V2-ndk",
        "libstatslog",
    ],

    proto: {
        include_dirs: [
            "external/protobuf/src",
        ],
    },

    data: [
        ":libprotobuf-internal-protos",
        ":libstats_internal_protos",
        ":libstats_proto_host",
        "test_external.proto",
    ],

    test_options: {
        unit_test: true,
    },

    required: [
        "libprotobuf-cpp-full",
        "libstats_proto_host",
    ],
}

// Filegroup for stats-log-api-gen test proto.
filegroup {
    name: "stats_log_api_gen_test_protos",
    srcs: [
        "test.proto",
        "test_external.proto",
        "test_feature_atoms.proto",
        "test_vendor_atoms.proto",
        "test_vendor_extension_atoms.proto",
    ],
}

filegroup {
    name: "stats_log_api_gen_vendor_test_protos",
    srcs: [
        ":libstats_atom_options_protos",
        "test_vendor_extension_atoms.proto",
        // Intentionally out of order to ensure atom is loaded properly.
        "test_vendor_atoms.proto",
    ],
}

cc_atomslog_library_static {
    name: "libstatslog_test_external",
    atoms_module: "test",
    basename: "test_external_atoms",
    namespace: "android::ExternalAtoms",
    proto_srcs: [
        "test_vendor_atoms.proto",
    ],
    host_supported: true,
}

rust_test_host {
    name: "test_api_gen_vendor_rust",
    crate_name: "test_api_gen_vendor_rust",
    crate_root: "test_api_gen_vendor.rs",
    edition: "2021",
    rustlibs: [
        "android.frameworks.stats-V2-rust",
        "libtest_vendor_atoms_rust",
        "libmatches",
    ],
}

rust_test_host {
    name: "test_api_gen_rust",
    crate_name: "test_api_gen_rust",
    srcs: ["test_api_gen.rs"],
    edition: "2021",
    rustlibs: [
        "libstatslog_rust",
        "libstatslog_rust_header",
    ],
    static_libs: [
        "libstatssocket-fake",
        "libstatspull-fake",
    ],
    test_suites: ["general-tests"],
}

genrule {
    name: "test_vendor_atoms.rs",
    tools: ["stats-log-api-gen"],
    cmd: "$(location stats-log-api-gen) --rust $(out)" +
        " --interface vendor" +
        " --proto frameworks/proto_logging/stats/stats_log_api_gen/test_vendor_atoms.proto",
    out: [
        "test_vendor_atoms.rs",
    ],
    srcs: [
        "test_vendor_atoms.proto",
        ":libprotobuf-internal-descriptor-proto",
        ":libstats_atom_options_protos",
    ],
}

rust_library {
    name: "libtest_vendor_atoms_rust",
    crate_name: "test_vendor_atoms",
    srcs: [":test_vendor_atoms.rs"],
    edition: "2021",
    rustlibs: [
        "android.frameworks.stats-V2-rust",
    ],
    host_supported: true,
}

// ==========================================================
// Native library
// ==========================================================
genrule {
    name: "statslog.h",
    tools: ["stats-log-api-gen"],
    cmd: "$(location stats-log-api-gen) --header $(genDir)/statslog.h",
    out: [
        "statslog.h",
    ],
}

genrule {
    name: "statslog.cpp",
    tools: ["stats-log-api-gen"],
    cmd: "$(location stats-log-api-gen) --cpp $(genDir)/statslog.cpp",
    out: [
        "statslog.cpp",
    ],
}

cc_library {
    name: "libstatslog",
    host_supported: true,
    generated_sources: [
        "statslog.cpp",
    ],
    generated_headers: [
        "statslog.h",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
    export_generated_headers: [
        "statslog.h",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libstatssocket",
        "libstatspull",
    ],
    export_shared_lib_headers: [
        "libstatssocket",
        "libstatspull",
    ],
    target: {
        host: {
            static_libs: [
                "libbase",
                "statsd-aidl-ndk",
            ],
            shared_libs: ["libbinder_ndk"],
        },
        darwin: {
            enabled: false,
        },
    },
}

// ==========================================================
// Rust library
// ==========================================================

genrule {
    name: "statslog_header.rs",
    tools: ["stats-log-api-gen"],
    cmd: "$(location stats-log-api-gen) --rustHeader $(genDir)/statslog_header.rs --rustHeaderCrate statslog_rust_header",
    out: [
        "statslog_header.rs",
    ],
}

rust_library {
    name: "libstatslog_rust_header",
    crate_name: "statslog_rust_header",
    srcs: [
        "rust_header_wrapper.rs",
        ":statslog_header.rs",
    ],
    rustlibs: [
        "libstatspull_bindgen",
        "libthiserror",
    ],
    host_supported: true,
    apex_available: [
        "//apex_available:platform",
        "com.android.resolv",
        "com.android.tethering",
        "com.android.uprobestats",
        "com.android.virt",
    ],
    min_sdk_version: "29",
}

genrule {
    name: "statslog.rs",
    tools: ["stats-log-api-gen"],
    cmd: "$(location stats-log-api-gen) --rust $(genDir)/statslog.rs --rustHeaderCrate statslog_rust_header",
    out: [
        "statslog.rs",
    ],
}

// libstatslog_rust is available from "//apex_available:platform" only.
// If you want to support libstatslog from Rust in other apex, you should create
// a new libstatslog_<module>_rust library (e.g. libstatslog_dns_resolver_rust).
rust_library {
    name: "libstatslog_rust",
    crate_name: "statslog_rust",
    srcs: [
        "rust_wrapper.rs",
        ":statslog.rs",
    ],
    rustlibs: [
        "libstatslog_rust_header",
        "libstatspull_bindgen",
    ],
    flags: [
        "-A clippy::needless-lifetimes",
    ],
    host_supported: true,
}
