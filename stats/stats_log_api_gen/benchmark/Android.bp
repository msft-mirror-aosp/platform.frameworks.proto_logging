package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_android_telemetry_client_infra",
}

cc_benchmark {
    name: "stats-log-api-gen-benchmark",
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
        "-Wno-deprecated-declarations",
        "-Wno-enum-compare",
        "-Wno-missing-field-initializers",
        "-Wno-unused-function",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        // Bug: http://b/29823425 Disable -Wvarargs for Clang update to r271374
        "-Wno-varargs",
        "-Wthread-safety",
    ],
    srcs: [
        "src/generated_code_benchmark.cpp",
        "src/main.cpp",
        "src/protobuf_benchmark.cpp",
        "src/struct_benchmark.cpp",
    ],
    generated_headers: [
        "test_atom_cc_gen_hdrs",
    ],
    generated_sources: [
        "test_atom_cc_gen_srcs",
    ],
    header_libs: [
        "libstatspull_headers",
        "libstatssocket_headers",
    ],
    static_libs: [
        "libgtest",
        "libstatspull-fake",
        "libstatssocket-fake",
    ],
    shared_libs: [
        "libprotobuf-cpp-lite",
        "libtestatom-large-proto-cpp",
        "libtestatom-medium-proto-cpp",
        "libtestatom-small-proto-cpp",
    ],
    required: [
        "libtestatom-large-proto-cpp",
        "libtestatom-medium-proto-cpp",
        "libtestatom-small-proto-cpp",
    ],
    data: [
        ":libtestatom-large-proto-cpp",
        ":libtestatom-medium-proto-cpp",
        ":libtestatom-small-proto-cpp",
    ],
    test_config: "AndroidTest.xml",
}

cc_library_shared {
    name: "libtestatom-large-proto-cpp",
    proto: {
        type: "lite",
        export_proto_headers: true,
        include_dirs: [
            "external/protobuf/src",
        ],
    },
    srcs: [
        "src/atom_large.proto",
    ],
    shared_libs: [
        "libprotobuf-cpp-lite",
    ],
    export_include_dirs: ["src"],
}

cc_library_shared {
    name: "libtestatom-medium-proto-cpp",
    proto: {
        type: "lite",
        export_proto_headers: true,
        include_dirs: [
            "external/protobuf/src",
        ],
    },
    srcs: [
        "src/atom_medium.proto",
    ],
    shared_libs: [
        "libprotobuf-cpp-lite",
    ],
    export_include_dirs: ["src"],
}

cc_library_shared {
    name: "libtestatom-small-proto-cpp",
    proto: {
        type: "lite",
        export_proto_headers: true,
        include_dirs: [
            "external/protobuf/src",
        ],
    },
    srcs: [
        "src/atom_small.proto",
    ],
    shared_libs: [
        "libprotobuf-cpp-lite",
    ],
    export_include_dirs: ["src"],
}

// Build target added to assess increased memory footprint
cc_library_shared {
    name: "libtestatom-all-proto-cpp",
    proto: {
        type: "lite",
        export_proto_headers: true,
        include_dirs: [
            "external/protobuf/src",
        ],
    },
    srcs: [
        "src/atom_large.proto",
        "src/atom_medium.proto",
        "src/atom_small.proto",
        "src/atoms_all.proto",
    ],
    shared_libs: [
        "libprotobuf-cpp-lite",
    ],
    export_include_dirs: ["src"],
}
