package {
    default_team: "trendy_team_android_telemetry_client_infra",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_test {
    name: "stats_code_gen_cc_test",
    srcs: [
        "AtomCodeGen_bootstrap_test.cpp",
        "AtomCodeGen_bootstrap_typesafe.cpp",
        "AtomCodeGen_platform_test.cpp",
        "AtomCodeGen_platform_typesafe.cpp",
    ],
    generated_headers: [
        "bootstrap_atom_cc_gen_typesafe_hdrs",
    ],
    test_suites: [
        "device-tests",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-g",
        "-Wno-deprecated-declarations",
    ],
    shared_libs: [
        "android.os.statsbootstrap_aidl-cpp",
        "libstatsbootstrap",
    ],
    static_libs: [
        "libgmock",
        "libstatslog_bootstrap_test",
        "libstatslog_cts",
        "libstatslog_test",
        "libstatslog_typesafe_test",
    ],
}

cc_test_host {
    name: "stats_code_gen_srcs_cc_host_test",
    test_suites: ["general-tests"],
    srcs: ["host/StatsHistogram_test.cpp"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-g",
        "-Wno-deprecated-declarations",
    ],
    static_libs: [
        "stats-log-api-gen-cc-lib",
        "libgmock_host",
    ],
    test_options: {
        unit_test: true,
    },
}

genrule {
    name: "bootstrap_atom_cc_gen_typesafe_hdrs",
    tools: ["stats-log-api-gen"],
    out: ["statslog_bootstrap_typesafe.h"],
    cmd: "$(location stats-log-api-gen) --header $(out)" +
        "  --module apex" +
        "  --namespace android::stats::bs::typesafe" +
        "  --type-safe" +
        "  --interface bootstrap",
}

cc_atomslog_library_static {
    name: "libstatslog_typesafe_test",
    atoms_module: "statsdtest",
    namespace: "android::stats::typesafe",
    basename: "statslog_test_typesafe",
    include_default_libs: "none",
    whole_static_libs: [
        "libstatspull-fake",
        "libstatssocket-fake",
    ],
    gen_type: "typesafe",
}

cc_atomslog_library_static {
    name: "libstatslog_bootstrap_test",
    atoms_module: "apex",
    namespace: "android::stats::bs",
    basename: "statslog_bootstrap_test",
    include_default_libs: "none",
    whole_static_libs: [
        "libstatspull-fake",
        "libstatssocket-fake",
    ],
    interface: "bootstrap",
    shared_libs: [
        "android.os.statsbootstrap_aidl-cpp",
        "libstatsbootstrap",
    ],
}

cc_atomslog_library_static {
    name: "libstatslog_test",
    atoms_module: "statsdtest",
    namespace: "android::stats",
    basename: "statslog_test",
    include_default_libs: "none",
    whole_static_libs: [
        "libstatspull-fake",
        "libstatssocket-fake",
    ],
}

cc_atomslog_library_static {
    name: "libstatslog_cts",
    atoms_module: "cts",
    namespace: "android,stats,cts",
    basename: "statslog_cts",
    include_default_libs: "none",
    whole_static_libs: [
        "libstatspull-fake",
        "libstatssocket-fake",
    ],
}
