package {
    default_team: "trendy_team_android_telemetry_client_infra",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_test {
    name: "StatsCodeGenJavaTest",
    test_suites: [
        "general-tests",
    ],
    srcs: [
        "src/**/*.java",
    ],
    static_libs: [
        "junit",
        "compatibility-device-util-axt",
        "statsdtest_cts_java_gen",
        "statsdtest_java_gen",
        "statsdtest_worksource_java_gen",
        "test_generic_vendor_java_gen",
        "test_platform_external_java_gen",
        "test_vendor_java_gen",
    ],
    libs: [
        "android.test.runner.stubs.system",
    ],
}

java_test_host {
    name: "StatsCodeGenSrcsJavaHostTest",
    test_suites: [
        "general-tests",
    ],
    srcs: [
        "host/src/**/*.java",
        ":stats-log-api-gen-java-srcs",
    ],
    static_libs: [
        "TestParameterInjector",
        "junit",
        "truth",
    ],
}

java_atomslog_library {
    name: "test_vendor_java_gen",
    atoms_module: "test",
    package_name: "com.android.test.statslogapigen",
    class_name: "VendorAtomsLog",
    interface: "vendor",
    proto_srcs: [":stats_log_api_gen_vendor_test_protos"],
}

java_atomslog_library {
    name: "test_generic_vendor_java_gen",
    atoms_module: "generic-vendor-test",
    package_name: "com.android.test.statslogapigen",
    class_name: "GenericVendorAtomsLog",
    interface: "vendor",
}

java_atomslog_library {
    name: "test_platform_external_java_gen",
    atoms_module: "test",
    package_name: "com.android.test.statslogapigen",
    class_name: "PlatformExternalAtomsLog",
    proto_srcs: [":stats_log_api_gen_vendor_test_protos"],
}

java_atomslog_library {
    name: "statsdtest_java_gen",
    atoms_module: "statsdtest",
    package_name: "com.android.test.statslogapigen",
    class_name: "TestAtomsLog",
}

java_atomslog_library {
    name: "statsdtest_worksource_java_gen",
    atoms_module: "statsdtest",
    package_name: "com.android.test.statslogapigen.worksource",
    class_name: "TestAtomsLogWs",
    worksource_support: true,
}

java_atomslog_library {
    name: "statsdtest_cts_java_gen",
    atoms_module: "cts",
    package_name: "com.android.cts.statslogapigen",
    class_name: "CtsAtomsLog",
}
